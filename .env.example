# Server-only. Copy this file to .env and fill in the real key locally.
# Never commit .env. Never expose GEMINI_API_KEY or REDIS_URL to the frontend.
# Put the real Gemini key in .env only. Leave this example value empty.
# REDIS_URL is read by the API. Do not put a password in logs or in the frontend.

# apps/api
PORT=3001
HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
REDIS_URL=redis://localhost:6379
# Public browser origin allowed to call the API. Leave empty for local development.
# Example for a deployed site: https://cache.example.com
WEB_ORIGIN=
CACHE_TTL_SECONDS=86400
# Initial semantic HIT threshold. Safety guards come in a later phase.
SEMANTIC_SIMILARITY_THRESHOLD=0.85
SEMANTIC_TOP_K=5

# apps/web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
