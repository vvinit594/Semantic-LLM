{
  "name": "semantic-llm",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @semantic-llm/api dev",
    "dev:web": "pnpm --filter @semantic-llm/web dev",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @semantic-llm/web lint",
    "build:web": "pnpm --filter @semantic-llm/web build"
  }
}
